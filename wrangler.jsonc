{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kepler-dashboard",
	"workers_dev": false,
	"compatibility_date": "2026-07-28",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"routes": [
		{
			"pattern": "dashboard.kepler-bot.net",
			"custom_domain": true
		}
	],
	"vars": {
		"APP_ENV": "production"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"env": {
		"dev": {
			"workers_dev": false,
			"routes": [
				{
					"pattern": "dev.dashboard.kepler-bot.net",
					"custom_domain": true
				}
			],
			"vars": {
				"APP_ENV": "development"
			}
		}
	}
}
